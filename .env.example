SONGSTREAMER_IMAGE=songstreamer:dev
SONGSTREAMER_UID=1000
SONGSTREAMER_GID=1000
SONGSTREAMER_PORT=3000
SONGSTREAMER_DATA_DIR=/srv/keystack-data/songstreamer/data
SONGSTREAMER_AUDIO_DIR=/srv/keystack-data/songstreamer/audio
CORS_ORIGIN=*
LOG_LEVEL=info
# Optional yt-dlp cache/remote-component overrides. The image bundles yt-dlp-ejs;
# leave YTDLP_REMOTE_COMPONENTS empty to avoid fetching remote code at import time.
YTDLP_CACHE_DIR=/tmp/yt-dlp-cache
YTDLP_REMOTE_COMPONENTS=
